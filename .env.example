# Configuration d'Eniv : copier ce fichier en .env puis le compléter.
# Les variables marquées (obligatoire) sont nécessaires en production.

# --- Application ---------------------------------------------------------
# Adresse publique de l'app, sans / final (liens des e-mails, Discord...)
BASE_URL=https://app.eniv.fr
# Secret de signature des jetons de connexion (obligatoire) : openssl rand -hex 48
# Le serveur refuse de démarrer sans lui ou avec une valeur d'exemple.
JWT_SECRET=
# Mot de passe du compte superadmin créé au premier démarrage.
# Vide : un mot de passe aléatoire est généré et affiché une fois dans les journaux.
SUPERADMIN_PASSWORD=

# --- Base de données MySQL (obligatoire) ----------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ent
DB_USER=root
DB_PASSWORD=

# --- E-mails (Brevo) : invitations, mot de passe, quiz prêt ---------------
BREVO_API_KEY=
BREVO_SENDER_EMAIL=noreply@eniv.fr
BREVO_SENDER_NAME=Eniv

# --- Génération de quiz par IA --------------------------------------------
# Classes standard (Groq)
GROQ_API_KEY=
# Comptes premium (Anthropic)
PREMIUM_API_KEY=

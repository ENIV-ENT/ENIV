# Eniv configuration: copy this file to .env, then fill it in.
# Variables marked (required) are needed in production.

# --- Application ---------------------------------------------------------
# Public address of the app, without a trailing / (links in emails, Discord...)
BASE_URL=https://app.eniv.fr
# Signing secret of the login tokens (required): openssl rand -hex 48
# The server refuses to start without it or with a sample value.
JWT_SECRET=
# Password of the superadmin account created on first startup.
# Empty: a random password is generated and printed once in the logs.
SUPERADMIN_PASSWORD=

# --- MySQL database (required) --------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ent
DB_USER=root
DB_PASSWORD=

# --- Emails (Brevo): invitations, password, quiz ready -------------------
BREVO_API_KEY=
BREVO_SENDER_EMAIL=noreply@eniv.fr
BREVO_SENDER_NAME=Eniv

# --- AI quiz generation --------------------------------------------------
# Standard classes (Groq)
GROQ_API_KEY=
# Premium accounts (Anthropic)
PREMIUM_API_KEY=

# A visitor already logged in to the app (hint cookie set by app.eniv.fr, see
# public/js/utils/api.js) is sent from the home page straight to the app.
# Robots do not have this cookie and always see the showcase site.
# "?vitrine" shows the showcase site anyway.
RewriteEngine On
RewriteCond %{QUERY_STRING} !(^|&)vitrine(=|&|$)
RewriteCond %{HTTP_COOKIE} (^|;\s*)eniv_session=1(;|$)
RewriteRule ^(index\.html)?$ https://app.eniv.fr/ [R=302,L]

# The home page response depends on the cookie: no shared cache.
<IfModule mod_headers.c>
    <Files "index.html">
        Header set Cache-Control "no-cache"
        Header merge Vary "Cookie"
    </Files>
</IfModule>
